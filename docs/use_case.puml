@startuml
top to bottom direction

actor "Користувач" as User
actor "Клієнт" as Client
actor "Менеджер" as Manager
actor "Адміністратор" as Admin

' Спадкування
Client -up-|> User
Manager -up-|> User
Admin -up-|> User

' Базові дії 
usecase "Авторизація / Реєстрація" as UC_Auth
usecase "Пошук та фільтрація турів" as UC_Search

' Дії Клієнта 
usecase "Бронювання туру" as UC_Book
usecase "Вибір готелю" as UC_Hotel
usecase "Застосування промокоду" as UC_Promo
usecase "Оплата замовлення" as UC_Pay
usecase "Генерація ваучера" as UC_Voucher
usecase "Скасування бронювання" as UC_Cancel

' Дії персоналу
usecase "Підтвердження бронювання" as UC_Confirm
usecase "Формування списків групи" as UC_Group
usecase "Генерація звітів з продажів" as UC_Report
usecase "Керування каталогом (Тури/Готелі)" as UC_ManageTours
usecase "Управління користувачами" as UC_ManageUsers

' --- ЗВ'ЯЗКИ ---

User --> UC_Auth
User --> UC_Search

' Клієнт ініціює Бронювання
Client --> UC_Book

UC_Book ..> UC_Auth : <<include>>
UC_Book ..> UC_Search : <<include>>

UC_Book ..> UC_Hotel : <<include>>
UC_Book ..> UC_Pay : <<include>>
UC_Pay ..> UC_Voucher : <<include>>

UC_Cancel ..> UC_Book : <<extend>>
UC_Promo ..> UC_Book : <<extend>>

' Дії Менеджера
Manager --> UC_Confirm
Manager --> UC_Group
Manager --> UC_Report

' Дії Адміністратора
Admin --> UC_ManageTours
Admin --> UC_ManageUsers
Admin --> UC_Report

@enduml
